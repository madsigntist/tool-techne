{
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/hooks/tool-guard.mjs\" ] || exit 0; node \"$CLAUDE_PROJECT_DIR/scripts/hooks/tool-guard.mjs\"",
          "timeout": 10
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
      "hooks": [
        {
          "type": "command",
          "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/hooks/tool-guard.mjs\" ] || exit 0; node \"$CLAUDE_PROJECT_DIR/scripts/hooks/tool-guard.mjs\"",
          "timeout": 10
        }
      ]
    }
  ]
}
